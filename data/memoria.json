    "uni_189c7349cb": {
        "stato": "ignorato",
        "titolo": "Da Italgas la call Shaping the Future of Energy Networks",
        "url": "https://www.emiliaromagnastartup.it/it/innovative/bandi/da-italgas-la-call-shaping-future-energy-networks",
        "tipo": "universita",
        "scadenza": "31/07/2026",
        "luogo": "Italia (non specificato un luogo fisico specifico per il programma di accelerazione)",
        "durata": "Non specificato, percorso di accelerazione e incubazione",
        "ente": "Italgas (in collaborazione con EmiliaRomagnaStartUp)",
        "argomenti": "Reti energetiche resilienti, decarbonizzazione, efficienza energetica, intelligenza artificiale e sensoristica per reti gas e acqua, sviluppo di startup e soluzioni innovative nel settore energia e ambiente.",
        "requisiti": "Gruppi di lavoro o società costituite con progetti innovativi negli ambiti 'Resilient Grid' o 'Energy Transition'. I progetti possono essere in fase di 'Idea' (prototipabile entro 2027), 'MVP' (prototipo con nuove opportunità di mercato) o 'Products on the market' (già commercializzati o pronti al lancio). Non sono richiesti specifici dipartimenti accademici, rendendo la call accessibile anche a studenti magistrali con progetti imprenditoriali.",
        "voto": 9,
        "data_rilevazione": "03/07/2026"
    },
    "uni_30baa0ab6f": {
        "stato": "ignorato",
        "titolo": "Planet Foundamentals: la call di SocialFare 2026",
        "url": "https://www.emiliaromagnastartup.it/it/innovative/bandi/planet-foundamentals-la-call-di-socialfare-2026",
        "tipo": "universita",
        "scadenza": "22/07/2026",
        "luogo": "Torino, Piemonte, Liguria, Valle d'Aosta",
        "durata": "Non specificata, programma di accelerazione intensivo",
        "ente": "SocialFare",
        "argomenti": "Programma di accelerazione per startup ad impatto e imprese sociali. Temi: innovazione sociale (persone) e sostenibilità ambientale (pianeta). Settori: Energia e Ambiente, ICT, Innovazione Sociale.",
        "requisiti": "Destinatari: Startup già costituite (innovative, SIAVS, S.r.l.), realtà ancora in fase di costituzione e Imprese Sociali (S.r.l. o Cooperative). Richiesto impatto sociale intenzionale, addizionale e misurabile e offerta di un prodotto/servizio altamente innovativo. Le Imprese Sociali devono avere sede legale in Piemonte, Liguria o Valle d'Aosta. Non è un bando per mobilità studentesca o borse di studio dirette a studenti, ma per progetti imprenditoriali.",
        "voto": 6,
        "data_rilevazione": "15/07/2026"
    },
    "uni_b6836ca6cd": {
        "stato": "ignorato",
        "titolo": "Startup Showcase - People Tech Forum 2026 (Bologna)",
        "url": "https://www.emiliaromagnastartup.it/it/innovative/bandi/startup-showcase-people-tech-forum-2026-bologna",
        "tipo": "universita",
        "scadenza": "31/07/2026",
        "luogo": "Bologna, Italia",
        "durata": "N.D.",
        "ente": "Ecosistema Formazione Italia (EFI), BI‑REX Competence Center, Fondazione Golinelli",
        "argomenti": "Startup Showcase per soluzioni innovative nei settori EdTech e HRTech (tecnologie per la formazione e le risorse umane), innovazione, imprenditorialità.",
        "requisiti": "Il bando è rivolto a startup (team o già costituite) con soluzioni innovative nei settori EdTech e HRTech. Andrea, come studente magistrale DCI con curricula di imprenditorialità e diverse esperienze in progetti di startup, potrebbe partecipare presentando un proprio progetto o idea di startup in questi ambiti. Non sono elencati specifici dipartimenti universitari ammessi o esclusi. La seconda data di chiusura per le candidature è il 31/08/2026.",
        "voto": 7,
        "data_rilevazione": "23/07/2026"
    },
    "uni_8c1e974aa5": {
        "stato": "nuovo",
        "titolo": "https://www.emiliaromagnastartup.it/it/innovative-creative/bandi/erasmus-giovani-imprenditori-open-eye",
        "url": "https://www.emiliaromagnastartup.it/it/innovative-creative/bandi/erasmus-giovani-imprenditori-open-eye",
        "tipo": "universita",
        "scadenza": "31/01/2027",
        "luogo": "Paesi europei aderenti al Programma",
        "durata": "Da 1 a 6 mesi",
        "ente": "Commissione Europea (promosso da Eurochambres, per Emilia-Romagna ART-ER)",
        "argomenti": "Esperienze d'impresa, internazionalizzazione PMI, creazione startup, trasferimento di conoscenze, formazione imprenditoriale.",
        "requisiti": "Essere un 'Nuovo Imprenditore' o 'Aspirante Imprenditore' (New Entrepreneur) che pianifica fermamente di avviare la propria attività o l'ha avviata negli ultimi 3 anni, con un progetto o un'idea d'impresa valida e un business plan. Essere residente permanente in uno dei paesi partecipanti. Non richiede laurea magistrale già conseguita. Il bando è aperto a tutti i settori e non elenca dipartimenti o corsi ammessi/esclusi, rendendolo compatibile con DCI/Economia/Biagi/Management, in quanto il focus è sul profilo imprenditoriale.",
        "voto": 9,
